    {"conflict_id":"WA-HOTMA-MANUAL-001","status":"UNRESOLVED","description":"The compliance landing page advertises HOTMA updates while the captured chapter and FAQ files identify mostly December 2024 revisions; exact supersession and effective-date rules require review."},
    {"conflict_id":"WA-HISTORIC-PROCEDURE-001","status":"UNRESOLVED","description":"The qualified-contract and recertification-waiver chapters identify February 2009 revisions and cannot be treated as universally current without property and legal review."},
    {"conflict_id":"WA-FORM-SCOPE-001","status":"UNRESOLVED","description":"Self-certification, post-Year 15, bond-layered, and annual-report documents have restricted scopes and submission cycles that must not be applied globally."}
