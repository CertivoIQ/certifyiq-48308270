  "blocking_conflicts": [
    {
      "conflict_id": "WI-QAP-COMPOSITION-001",
      "status": "UNRESOLVED",
      "description": "The live current QAP is self-identified as Revised July 2026 while WHEDA also publishes seven separate modification summaries; the exact consolidated hierarchy must be approved."
    },
    {
      "conflict_id": "WI-PROSPECTIVE-2027-001",
      "status": "UNRESOLVED",
      "description": "The 2027-2028 QAP is already published but must not supersede the current 2025-2026 rules before its approved prospective effective date."
    },
    {
      "conflict_id": "WI-MODIFICATION-SCOPE-001",
      "status": "UNRESOLVED",
      "description": "The seven modifications have different application-cycle, credit-type, and transaction-date scopes and cannot be applied globally to every property."
    },
    {
      "conflict_id": "WI-LIMIT-LAYERING-001",
      "status": "UNRESOLVED",
      "description": "WHEDA publishes distinct MTSP, HERA, Average Income, Section 8, and financing-only limit tables; the platform must select only the tables applicable to each property and program layer."
    },
    {
      "conflict_id": "WI-EXTENDED-USE-FORM-SCOPE-001",
      "status": "UNRESOLVED",
      "description": "The tenant self-recertification form is published under Extended Use and must not be applied to initial compliance-period households without validated authority."
    },
    {
      "conflict_id": "WI-MANUAL-SUPPLEMENT-001",
      "status": "UNRESOLVED",
      "description": "The August 2026 compliance manual states that it is a supplement rather than a complete compliance guide, requiring rule citations to controlling sources and program-specific documents."
    }
  ],
